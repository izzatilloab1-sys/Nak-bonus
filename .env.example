# ============================================================
#  SO'M BONUS BOT — sozlamalar namunasi
#  Bu faylni .env ga nusxalang va qiymatlarni to'ldiring:
#    cp .env.example .env
# ============================================================

# ------- Telegram bot -------
# @BotFather dan olingan token
BOT_TOKEN=123456:AAAABBBBCCCCDDDD

# Admin Telegram ID'lari (vergul bilan). Birinchisi — bot egasi (owner).
# ID'ingizni bilish uchun @userinfobot ga yozing.
ADMIN_IDS=123456789

# ------- Ma'lumotlar bazasi -------
# SQLite (async). Odatda o'zgartirishsiz qoldiriladi.
DB_URL=sqlite+aiosqlite:///bonus_bot.db

# ------- Referal (so'm) -------
# Yangi referal RO'YXATDAN O'TGANDA (raqam tasdiqlagach) egasiga darhol beriladigan so'm
REFERRAL_JOIN_BONUS=1000
# Referal HAR BIR zadaniya bajarganda egasiga beriladigan so'm (3 kun oynasi ichida)
REFERRAL_TASK_BONUS=2000
# (eski sozlama — endi ishlatilmaydi, moslik uchun)
REFERRAL_TASK_THRESHOLD=1
# Referal ro'yxatdan o'tgach SHU KUN ichida zadaniya bajarsa egasiga bonus boradi.
# Bu muddatdan keyin bajarsa — egaga hech narsa bormaydi.
REFERRAL_WINDOW_DAYS=3
# Zadaniya bajargach SHU KUN ichida kanaldan chiqib ketsa — bonus ikkala
# tomondan qaytariladi. Bu muddatdan keyin chiqsa — bonus qoladi.
UNSUB_CHECK_DAYS=7

# ------- Balans to'ldirish -------
# Minimal to'ldirish summasi (so'm)
MIN_TOPUP=1000

# ============================================================
#  PAYME MERCHANT (JSON-RPC 2.0) — avtomatik to'lov
# ============================================================
# Payme kabinetidan olinadi (test yoki production)
PAYME_MERCHANT_ID=your_merchant_id
# Payme Merchant kaliti (Paycom:KEY Basic Auth uchun)
PAYME_SECRET_KEY=your_payme_secret_key
# Payme Checkout bazaviy URL (test: https://checkout.test.paycom.uz)
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# ------- Webhook server (Payme callback) -------
# Payme callback'lari keladigan host/port
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Payme Merchant kabinetida ko'rsatiladigan endpoint yo'li
PAYME_ENDPOINT_PATH=/payme

# ============================================================
#  ZAXIRA (BACKUP)
# ============================================================
# Zaxira kanali .env orqali emas, BOT ICHIDAN ulanadi:
#   /admin → 💾 Backup → 📢 Kanalni ulash
# Har kuni 00:00 (server vaqti) foydalanuvchilar va balanslar fayli
# (CSV) kanalga avtomatik yuboriladi. To'liq .db backup esa /backup
# buyrug'i yoki admin paneldagi tugma orqali qo'lda olinadi.
